rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 200;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'userId', 'items', 'totalUSD', 'status'])
        && data.orderId is string
        && data.userId is string && data.userId == request.auth.uid
        && data.items is list
        && data.totalUSD is number
        && data.status is string;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'title', 'comment'])
        && data.id is string
        && data.productId is string
        && data.userId is string && data.userId == request.auth.uid
        && data.userName is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isSignedIn() && existing().userId == request.auth.uid && isValidOrder(incoming());
    }

    // Wishlists collection
    match /wishlists/{userId} {
      allow get, write: if isValidId(userId) && isOwner(userId);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isSignedIn() && isValidReview(incoming());
      allow update: if isValidId(reviewId) && isSignedIn() && existing().userId == request.auth.uid && isValidReview(incoming());
    }
  }
}
